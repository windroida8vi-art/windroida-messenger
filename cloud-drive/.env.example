# Copy to .env and edit. Never commit .env. All values are optional.
CD_HOST=0.0.0.0
CD_PORT=8082
# CD_DATA_DIR=./data
# Leave empty: a random key is generated once into data/secret.key. Or set your own (64+ random chars).
CD_SECRET_KEY=
# Windroida single sign-on: paste the exact content of Windroida's data/drive_sso.key here.
# Leave empty to keep SSO disabled (the /sso link will just be refused).
CD_SSO_SECRET=
# Set to 1 when you serve through HTTPS (Caddy/Nginx, or CD_SSL_CERT/CD_SSL_KEY below): marks the cookie
# Secure + sends HSTS. start.py sets this (and the two below) by itself - only needed here for a standalone run.
CD_COOKIE_SECURE=0
# Run https directly (no reverse proxy needed), using this certificate/key pair - e.g. Windroida's own
# data/server.crt and data/server.key, reused as-is. Leave both empty for plain http.
CD_SSL_CERT=
CD_SSL_KEY=
# Set to 1 ONLY behind your own reverse proxy (so the real client IP is read from X-Forwarded-For)
CD_TRUSTED_PROXY=0
# 0 = no per-file upload limit (the user quota and free disk space still apply)
CD_MAX_UPLOAD_MB=0
# default per-user quota in MB (7168 = 7 GB). Raise one user later in Admin panel > Users > Edit
CD_DEFAULT_QUOTA_MB=7168
CD_CHUNK_SIZE_MB=4
# Optional malware scanner; {path} is replaced by the file path. Non-zero exit = file rejected.
# CD_SCAN_COMMAND=clamscan --no-summary {path}
